#include <iostream>
#include <string>
using namespace std;

void showProducts(string id[], string name[], string category[],
                  string gender[], string size[], string color[],
                  double price[], int stock[], int productCount)
{
    cout << "\n========== ALL PRODUCTS ==========\n";

    for (int i = 0; i < productCount; i++)
    {
        cout << "\nID: " << id[i];
        cout << "\nName: " << name[i];
        cout << "\nCategory: " << category[i];
        cout << "\nGender: " << gender[i];
        cout << "\nSize: " << size[i];
        cout << "\nColor: " << color[i];
        cout << "\nPrice: $" << price[i];
        cout << "\nStock: " << stock[i];
        cout << "\n-------------------------\n";
    }
}

void showCategories()
{
    cout << "\n========== CATEGORIES ==========\n";
    cout << "1. Women\n";
    cout << "2. Men\n";
    cout << "3. Kids\n";
    cout << "4. Shoes\n";
    cout << "5. Bags\n";
    cout << "6. Accessories\n";
}

void searchProducts(string id[], string name[], string category[],
                    double price[], int stock[], int productCount)
{
    string search;
    bool found = false;

    cout << "\nEnter Product ID, Name or Category: ";
    cin >> search;

    for (int i = 0; i < productCount; i++)
    {
        if (id[i] == search || name[i] == search || category[i] == search)
        {
            cout << "\nProduct Found!\n";
            cout << "ID: " << id[i] << endl;
            cout << "Name: " << name[i] << endl;
            cout << "Category: " << category[i] << endl;
            cout << "Price: $" << price[i] << endl;
            cout << "Stock: " << stock[i] << endl;

            found = true;
        }
    }

    if (found == false)
    {
        cout << "\nProduct Not Found.\n";
    }
}

void showCart(string name[], double price[], int quantity[],
              string size[], string color[], int productCount)
{
    double subtotal = 0;
    bool empty = true;

    cout << "\n========== SHOPPING CART ==========\n";

    for (int i = 0; i < productCount; i++)
    {
        if (quantity[i] > 0)
        {
            cout << "\nProduct: " << name[i];
            cout << "\nSize: " << size[i];
            cout << "\nColor: " << color[i];
            cout << "\nQuantity: " << quantity[i];
            cout << "\nPrice: $" << price[i];
            cout << "\nTotal: $" << price[i] * quantity[i];
            cout << "\n-------------------------\n";

            subtotal += price[i] * quantity[i];
            empty = false;
        }
    }

    if (empty == true)
    {
        cout << "Cart is empty.\n";
    }
    else
    {
        cout << "\nSubtotal: $" << subtotal << endl;
    }
}

void lowStockReport(string name[], int stock[], int productCount)
{
    cout << "\n========== LOW STOCK REPORT ==========\n";

    bool found = false;

    for (int i = 0; i < productCount; i++)
    {
        if (stock[i] <= 10)
        {
            cout << name[i] << " --> " << stock[i] << " items left\n";
            found = true;
        }
    }

    if (found == false)
    {
        cout << "No low stock products.\n";
    }
}

void storeStatistics(string name[], double price[], int stock[],
                     int productCount)
{
    int totalItems = 0;
    int lowStock = 0;
    double stockValue = 0;

    for (int i = 0; i < productCount; i++)
    {
        totalItems += stock[i];
        stockValue += price[i] * stock[i];

        if (stock[i] <= 10)
        {
            lowStock++;
        }
    }

    cout << "\n========== STORE STATISTICS ==========\n";
    cout << "Number of Products: " << productCount << endl;
    cout << "Total Items In Stock: " << totalItems << endl;
    cout << "Low Stock Products: " << lowStock << endl;
    cout << "Total Stock Value: $" << stockValue << endl;
}

