            for (int i = 0; i < productCount; i++)
            {
                if (id[i] == productID)
                {
                    index = i;
                }
            }

            if (index == -1)
            {
                cout << "\nProduct not found.\n";
            }
            else if (quantity[index] == 0)
            {
                cout << "\nThis product is not in the cart.\n";
